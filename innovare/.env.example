# URL pública do site (Open Graph, sitemap e JSON-LD). Na Vercel, se ficar vazia,
# o domínio de produção do projeto é usado automaticamente.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Envio do formulário de contato (https://resend.com). Obrigatório em produção.
RESEND_API_KEY=
# Opcional: destinatário (padrão: innovarecontabilidadee@gmail.com)
CONTACT_TO=
# Opcional: remetente de um domínio verificado no Resend, ex.: "Site Innovare <site@seudominio.com.br>"
CONTACT_FROM=
